  movimientoCajaId Int              @unique
  pagoSueldo       PagoSueldo       @relation(fields: [pagoSueldoId], references: [id], onDelete: Restrict)
  creadoPor        Usuario          @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  movimientoCaja   MovimientoCaja   @relation("AjustePagoSueldoMovimiento", fields: [movimientoCajaId], references: [id], onDelete: Restrict)

  @@index([pagoSueldoId, fecha])
  @@index([creadoPorId])
}
