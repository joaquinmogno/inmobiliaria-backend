model PlanCuotas {
  id                 Int              @id @default(autoincrement())
  concepto           String
  montoTotal         Decimal          @db.Decimal(10, 2)
  moneda             Moneda           @default(ARS)
  tipoMovimiento     TipoMovimiento
  estado             EstadoPlanCuotas @default(VIGENTE)
  fechaCreacion      DateTime         @default(now())
  fechaCierre        DateTime?
  motivoCierre       String?          @db.Text
  inmobiliariaId     Int
  contratoId         Int
  esParaInmobiliaria Boolean          @default(false)
  planOrigenId       Int?
  cerradoPorId       Int?

  cuotas              CuotaPlan[]
  planOrigen          PlanCuotas?  @relation("PlanCuotasReprogramacion", fields: [planOrigenId], references: [id], onDelete: Restrict)
  planesReprogramados PlanCuotas[] @relation("PlanCuotasReprogramacion")
  cerradoPor          Usuario?     @relation("PlanCuotasCerradoPor", fields: [cerradoPorId], references: [id], onDelete: SetNull)
  inmobiliaria        Inmobiliaria @relation(fields: [inmobiliariaId], references: [id])
  contrato            Contrato     @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([contratoId])
  @@index([inmobiliariaId])
  @@index([planOrigenId])
  @@index([cerradoPorId])
}

model CuotaPlan {
  id               Int         @id @default(autoincrement())
  planId           Int
  numeroCuota      Int
  fechaVencimiento DateTime    @db.Date
  monto            Decimal     @db.Decimal(10, 2)
  moneda           Moneda      @default(ARS)
  estado           EstadoCuota @default(PENDIENTE)
  movimientoId     Int?        @unique
  liquidacionId    Int? // Para saber en qué liquidación se "programó" o cobró

  plan        PlanCuotas   @relation(fields: [planId], references: [id], onDelete: Cascade)
  movimiento  Movimiento?  @relation(fields: [movimientoId], references: [id], onDelete: SetNull)
  liquidacion Liquidacion? @relation(fields: [liquidacionId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@index([liquidacionId])
  @@index([fechaVencimiento, estado])
}

